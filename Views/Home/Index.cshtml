@{
    ViewData["Title"] = "Главная";
}

<style>
    .dashboard-card {
        background: linear-gradient(135deg, #4A90E2, #007AFF);
        color: white;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.3s ease;
        border-radius: 18px;
        height: 180px; 
        width: 240px; 
        padding: 20px; 
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        box-sizing: border-box; 
        text-align: center;
    }

    .dashboard-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .dashboard-icon {
        font-size: 2.7rem;
        margin-bottom: 8px;
    }

    .dashboard-title {
        font-weight: 600;
        font-size: 1.15rem;
        margin-bottom: 6px;
    }

    .dashboard-text {
        font-size: 0.9rem;
        opacity: 0.9;
        line-height: 1.3; 
    }

    h1 {
        font-weight: 700;
        margin-bottom: 40px;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 25px;
    }

    .btn-outline-danger {
        border-radius: 12px;
        padding: 8px 18px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }
</style>


<div class="container text-center mt-5">
    <h1>Панель управления транспортом</h1>

    <div class="card-container">
        <a asp-controller="Route" asp-action="Index" class="dashboard-card shadow-lg">
            <div class="dashboard-icon">🗺️</div>
            <div class="dashboard-title">Маршруты</div>
            <div class="dashboard-text">Просмотр и управление маршрутами</div>
        </a>

        <a asp-controller="Bus" asp-action="Index" class="dashboard-card shadow-lg">
            <div class="dashboard-icon">🚌</div>
            <div class="dashboard-title">Автобусы</div>
            <div class="dashboard-text">Управление автобусами и их данными</div>
        </a>

        <a asp-controller="Driver" asp-action="Index" class="dashboard-card shadow-lg">
            <div class="dashboard-icon">👨‍✈️</div>
            <div class="dashboard-title">Водители</div>
            <div class="dashboard-text">Информация о водителях</div>
        </a>

        <a asp-controller="Repair" asp-action="Index" class="dashboard-card shadow-lg">
            <div class="dashboard-icon">🔧</div>
            <div class="dashboard-title">Ремонты</div>
            <div class="dashboard-text">История ремонтов и обслуживания</div>
        </a>

        <a asp-controller="SparePart" asp-action="Index" class="dashboard-card shadow-lg">
            <div class="dashboard-icon">⚙️</div>
            <div class="dashboard-title">Склад запчастей</div>
            <div class="dashboard-text">Учёт запасных частей</div>
        @if (User.IsInRole("Admin"))
        {
             <a asp-controller="Admin" asp-action="Index" class="dashboard-card shadow-lg">
                <div class="dashboard-icon">🧑‍💼</div>
                <div class="dashboard-title">Администрирование</div>
                <div class="dashboard-text">Управление пользователями и ролями</div>
             </a>
        }
        </a>
    </div>
</div>
