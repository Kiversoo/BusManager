@model BusManager.Models.Repair

<h2>Добавить ремонт</h2>

<form method="post">
    <div class="form-group mb-3">
        <label asp-for="BusId" class="form-label">Автобус</label>
        <select asp-for="BusId" asp-items="ViewBag.Buses" class="form-control"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="form-label">Описание ремонта</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="RepairDate" class="form-label">Дата ремонта</label>
        <input asp-for="RepairDate" type="date" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Cost" class="form-label">Стоимость (₽)</label>
        <input asp-for="Cost" class="form-control" type="number" step="0.01" />
    </div>

    <button type="submit" class="btn btn-success mt-2">Сохранить</button>
</form>
