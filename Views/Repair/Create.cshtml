@model BusManager.Models.Repair

<h2>Добавить ремонт</h2>

<form method="post">
    <div class="form-group">
        <label>ID автобуса:</label>
        <input asp-for="BusId" type="number" class="form-control" />
    </div>
    <div class="form-group">
        <label>Описание ремонта:</label>
        <input asp-for="Description" class="form-control" />
    </div>
    <div class="form-group">
        <label>Дата:</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success mt-2">Сохранить</button>
</form>
