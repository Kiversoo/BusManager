@model BusManager.Models.Bus

@{
    ViewData["Title"] = "Детали автобуса";
}

<h2>@ViewData["Title"]</h2>

<div class="card p-3 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Модель</dt>
        <dd class="col-sm-9">@Model.Model</dd>

        <dt class="col-sm-3">Номер</dt>
        <dd class="col-sm-9">@Model.Number</dd>

        <dt class="col-sm-3">Вместимость</dt>
        <dd class="col-sm-9">@Model.Capacity</dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактировать</a>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>
