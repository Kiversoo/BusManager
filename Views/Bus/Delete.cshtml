@model BusManager.Models.Bus
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Удалить автобус";
}

<h2>Удалить автобус</h2>
<div class="alert alert-warning">
    Вы уверены, что хотите удалить автобус <strong>@Model.Model (@Model.Number)</strong>?
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>
