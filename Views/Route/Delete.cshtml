@model BusManager.Models.BusRoute

@{
    ViewData["Title"] = "Удалить маршрут";
    Layout = "_Layout";
}

<div class="delete-container text-center mt-5">
    <h2 class="text-danger mb-4">Удалить маршрут</h2>

    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <h5 class="mb-3 text-primary">@Model.Name</h5>
        <p><strong>Откуда:</strong> @Model.StartLocation</p>
        <p><strong>Куда:</strong> @Model.EndLocation</p>
        <p><strong>Дистанция:</strong> @Model.DistanceKm км</p>

        @if (!string.IsNullOrEmpty(Model.MapImagePath))
        {
            <img src="@Model.MapImagePath" alt="Карта маршрута" class="img-fluid rounded shadow-sm mb-3" style="max-height:200px;" />
        }

        <p class="text-muted">Вы уверены, что хотите удалить этот маршрут? Это действие необратимо.</p>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger me-3">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

<style>
    .delete-container h2 {
        font-weight: 700;
    }
    .btn-danger {
        background-color: #dc3545;
        border: none;
    }
    .btn-danger:hover {
        background-color: #c82333;
    }
    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }
    .btn-secondary:hover {
        background-color: #5a6268;
    }
</style>
