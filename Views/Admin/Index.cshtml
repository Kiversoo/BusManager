@model IEnumerable<BusManager.Models.ApplicationUser>

@{
    ViewData["Title"] = "Управление пользователями";
    Layout = "_Layout";
}

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>ID пользователя</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.Id</td>
                <td>
                    <a asp-action="MakeAdmin" asp-route-id="@user.Id" class="btn btn-success btn-sm">Назначить админом</a>
                    <a asp-action="RemoveAdmin" asp-route-id="@user.Id" class="btn btn-success btn-sm">Убрать роль</a>
                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
