@page
@{
    Layout = null;
}
@model LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}

<style>
    body {
        background: linear-gradient(135deg, #89CFF0, #E0FFFF);
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .login-container {
        background: white;
        padding: 40px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 380px;
        text-align: center;
    }

    .login-title {
        font-size: 28px;
        font-weight: 700;
        color: #007BFF;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .form-control {
        border-radius: 10px;
        margin-bottom: 15px;
        height: 45px;
        font-size: 16px;
        padding: 10px;
    }

    .btn-primary {
        background-color: #007BFF;
        border: none;
        border-radius: 10px;
        width: 100%;
        height: 45px;
        font-size: 16px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .links {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .links a {
        color: #007BFF;
        text-decoration: none;
        font-weight: 500;
    }

    .links a:hover {
        text-decoration: underline;
    }
</style>


<div class="login-container">
    <div class="login-title">🚍 BusManager</div>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <input asp-for="Input.Email" class="form-control" placeholder="Email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>

        <input asp-for="Input.Password" class="form-control" placeholder="Пароль" type="password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>

        <div class="checkbox mb-3 text-start">
            <label asp-for="Input.RememberMe" class="form-label">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                Запомнить меня
            </label>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary">Войти</button>

        <div class="links">
            <a asp-page="./ForgotPassword">Забыли пароль?</a>
            <a asp-page="./Register">Регистрация</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
